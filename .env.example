# Copy to .env.local for local `npm run dev`. Set the same keys as
# Environment Variables in Vercel (Project Settings -> Environment
# Variables). Never commit a real .env file.

# --- Existing marketing site vars (already configured in Vercel) ---------
# Listed here for completeness — not new, not required for local /os work.
# WEB3FORMS_ACCESS_KEY=
# RESEND_API_KEY=
# NOTIFY_FROM=
# NOTIFY_TO=
# SUBSCRIBE_WEBHOOK_URL=
# AUTOMATION_WEBHOOK_URL=

# --- CFOIP OS (/os) — Supabase project (Project Settings -> API) ---------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses Row Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_. Used by lib/os/supabase/admin.ts for
# Storage operations (the Documents feature) — see /docs/setup.md.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- CFOIP OS — Database (Project Settings -> Database -> Connection string) ---
# Pooled connection (port 6543, Transaction mode) — used by the running app.
DATABASE_URL="postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooled connection (port 5432) — used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres"

# --- CFOIP OS — Portfolio digest email (app/api/cron/portfolio-digest) ---
# Any random string — set the SAME value as a Vercel env var, and Vercel's
# Cron Jobs feature automatically sends it back as the request's Bearer
# token, which is how the endpoint tells a real weekly run (vercel.json)
# apart from a stranger hitting the public URL. Generate one with
# `openssl rand -hex 32`. Email delivery itself reuses the RESEND_API_KEY
# and NOTIFY_FROM already configured above — no separate email setup needed.
CRON_SECRET=

# --- CFOIP OS — AI CFO (Phase 4, not wired up yet) ------------------------
# None of these are read by any code today — the schema/permissions
# foundation is built (see /docs/decision-log.md "AI CFO foundation"), the
# actual AI provider and job-runner integration is the next slice once
# these are set. Listed now so the names are settled and Vercel can be
# configured ahead of that work, per decision #1/#2.

# A CFOIP-controlled OpenAI organisation + project — never a developer's
# personal account. Kept as an env var specifically so the model can change
# without a code deploy; every AgentRun row records which model/version it
# actually ran on (see AgentRun.model/modelVersion in prisma/schema.prisma),
# so switching this never makes a past run's record ambiguous about what
# produced it.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Trigger.dev — for document extraction, financial diagnostic runs, report
# generation, scheduled document requests, monthly-close workflows, and
# reminders (decision #2). Per decision #2, only development/test
# environments are to be configured initially — do not set these in the
# Production Vercel environment until the workflow and security tests
# pass. Get both from the Trigger.dev project dashboard once that project
# exists.
# TRIGGER_API_KEY=
# TRIGGER_PROJECT_ID=

# --- Local development only — never set in Vercel -------------------------
# Lets `prisma migrate dev` diff against a disposable local Postgres
# database instead of erroring "you must set shadowDatabaseUrl if you want
# to diff a migrations directory" — needed only for generating a *new*
# migration locally, never for `prisma migrate deploy` (what Vercel runs).
# SHADOW_DATABASE_URL=
