// CFOIP OS — Prisma schema
// Phase 0 / Phase 1 slice only. See /docs/data-model.md for the full target
// entity model (sections 20 of the product spec) and what remains to be added.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Internal (staff) roles — see /docs/security.md §"Roles" for the authority
// matrix. Client-facing roles (CLIENT_ADMIN, CLIENT_COLLABORATOR) are
// deferred to Phase 2 (client portal) and intentionally not modelled yet.
enum OrgRole {
  MANAGING_PARTNER
  PRACTICE_ADMIN
  PORTFOLIO_LEAD
  RELATIONSHIP_MANAGER
  SERVICE_LEAD
  PREPARER_ANALYST
  INDEPENDENT_REVIEWER
  FINANCE_BILLING
  READ_ONLY_AUDITOR
}

enum ClientLifecycleStage {
  PROSPECT
  ONBOARDING
  ACTIVE
  WATCH
  AT_RISK
  RENEWING
  PAUSED
  OFFBOARDING
  OFFBOARDED
}

enum ClientHealthStatus {
  HEALTHY
  WATCH
  AT_RISK
}

// Service portfolio bucket a client primarily sits in. Modelled as an enum
// for Phase 1; becomes a configurable ServicePackage entity in Phase 2+
// (see /docs/decision-log.md).
enum ServiceBucket {
  MONTHLY_CFO
  BOOKKEEPING_OVERSIGHT
  CASH_FLOW_ADVISORY
  INVESTOR_READINESS
  AD_HOC_PROJECTS
}

enum AuditAction {
  USER_SIGNED_UP
  USER_SIGNED_IN
  MEMBERSHIP_ROLE_CHANGED
  MEMBERSHIP_DEACTIVATED
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_LIFECYCLE_CHANGED
  WORKFLOW_TEMPLATE_CREATED
  TASK_TEMPLATE_ADDED
  WORKFLOW_INSTANTIATED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED
  TASK_REVIEWED
  CLIENT_PORTAL_INVITE_SENT
  CLIENT_PORTAL_ACCESS_CLAIMED
  CLIENT_PORTAL_ACCESS_REVOKED
  CLIENT_APPROVAL_SUBMITTED
  REQUEST_CREATED
  REQUEST_TRIAGED
  REQUEST_STATUS_CHANGED
  REQUEST_RESOLVED
  MEETING_LOGGED
  DECISION_ADDED
  DECISION_STATUS_CHANGED
  MEMBERSHIP_CAPACITY_SET
  PORTFOLIO_DIGEST_SENT
  STAFF_INVITE_SENT
  STAFF_INVITE_CLAIMED
  REPORTING_PERIOD_CREATED
  DOCUMENT_EXTRACTION_STARTED
  DOCUMENT_EXTRACTION_COMPLETED
  DOCUMENT_EXTRACTION_FAILED
  DOCUMENT_EXTRACTION_REVIEWED
  CFO_REVIEW_CREATED
  CFO_REVIEW_STATUS_CHANGED
  REVIEW_FINDING_CREATED
  REVIEW_FINDING_STATUS_CHANGED
  RISK_CREATED
  RISK_STATUS_CHANGED
  CONTROL_CREATED
  CONTROL_STATUS_CHANGED
  ACTION_ITEM_CREATED
  ACTION_ITEM_STATUS_CHANGED
  COMPLIANCE_DEADLINE_CREATED
  MATERIALITY_THRESHOLD_UPDATED
  APPROVAL_DECISION_RECORDED
  AGENT_RUN_STARTED
  AGENT_RUN_COMPLETED
  AGENT_RUN_FAILED
}

enum ClientRole {
  CLIENT_ADMIN
  CLIENT_COLLABORATOR
}

enum ClientApprovalOutcome {
  APPROVED
  CHANGES_REQUESTED
}

// How often a WorkflowTemplate's work recurs. Drives the default
// periodStart/periodEnd math when a WorkflowInstance is created — see
// src/lib/workflow/period.ts.
enum RecurrenceType {
  ONE_OFF
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum WorkflowInstanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// "Overdue" is deliberately not a stored status — it's derived from
// (dueDate < now && status not in DELIVERED) at read time, so a task can
// never go stale in an "overdue" state after someone fixes the due date.
// See computeIsOverdue() in src/lib/workflow/status.ts.
enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  AWAITING_CLIENT
  UNDER_REVIEW
  APPROVED
  DELIVERED
}

enum ReviewOutcome {
  APPROVED
  CHANGES_REQUESTED
}

// Drives slaDueAt at triage time (see triageRequestAction) — not a stored
// deadline the requester picks, so SLA commitments stay consistent across
// the portfolio rather than whatever a triager happens to type in.
enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// NEW (just raised, not yet looked at) -> TRIAGED (priority/SLA/assignee
// set) -> [AWAITING_APPROVAL if it needs scope sign-off before starting] ->
// IN_PROGRESS -> [AWAITING_CLIENT if staff needs something back from the
// client] -> COMPLETED, or DECLINED at any point before COMPLETED.
enum RequestStatus {
  NEW
  TRIAGED
  AWAITING_APPROVAL
  IN_PROGRESS
  AWAITING_CLIENT
  COMPLETED
  DECLINED
}

enum DecisionStatus {
  OPEN
  DONE
}

// --- AI CFO (Phase 4) — financial diagnostic domain ------------------------
// Foundation schema only: no AI provider is wired up yet (see
// /docs/decision-log.md "AI CFO foundation"). These tables exist so the
// deterministic calculation engine (lib/os/finance/) and, later, the
// document-extraction and agent-orchestration workflows have somewhere to
// write structured, sourced data — never a bare number with no evidence
// trail. Same tenant-isolation and RLS posture as every other table.

enum RiskRating {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFORMATIONAL
}

enum DocumentExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  NEEDS_REVIEW
}

// The financial-diagnostic review's own lifecycle — distinct from
// TaskStatus/ReviewOutcome, which govern one delivery-workflow Task. A
// CfoReview covers a whole engagement period's diagnostic, with its own
// multi-stage approval chain up to the Managing Partner.
enum CfoReviewStatus {
  DRAFT
  AI_REVIEW_COMPLETE
  FINANCE_REVIEW_REQUIRED
  RETURNED_FOR_CORRECTION
  SENIOR_REVIEW_REQUIRED
  MANAGING_PARTNER_APPROVAL_REQUIRED
  APPROVED
  RELEASED_TO_CLIENT
  ARCHIVED
}

enum FindingStatus {
  OPEN
  UNDER_REVIEW
  RETURNED_FOR_CORRECTION
  APPROVED
  RESOLVED
  ESCALATED
}

enum RiskStatus {
  OPEN
  MITIGATING
  CLOSED
}

enum ControlStatus {
  EFFECTIVE
  WEAK
  MISSING
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum DeadlineStatus {
  OPEN
  DONE
}

// Percent and absolute thresholds are configured separately per
// decision #5 — a category groups the rows that share a shape (both a %
// and an absolute figure per RiskRating tier).
enum MaterialityCategory {
  FINANCIAL_EXCEPTION
  BUDGET_VARIANCE
  CASH_RUNWAY
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  RETURNED
}

enum AgentType {
  ORCHESTRATOR
  DOCUMENT
  FINANCIAL_CONTROLLER
  FPA
  REPORTING
  RISK_CONTROLS
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  AWAITING_REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A single practice tenant. CFOIP runs one organization; the model stays
/// multi-tenant-shaped so a second practice could be onboarded without a
/// schema change.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  currency  String   @default("KES")
  timezone  String   @default("Africa/Nairobi")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]
  clients           Client[]
  auditEvents       AuditEvent[]
  workflowTemplates WorkflowTemplate[]
  workflowInstances WorkflowInstance[]
  documents         Document[]
  requests          Request[]
  meetings          Meeting[]

  reportingPeriods      ReportingPeriod[]
  documentExtractions   DocumentExtraction[]
  financialAccounts     FinancialAccount[]
  financialPeriodValues FinancialPeriodValue[]
  financialMetrics      FinancialMetric[]
  cfoReviews            CfoReview[]
  reviewFindings        ReviewFinding[]
  risks                 Risk[]
  controls              Control[]
  actionItems           ActionItem[]
  complianceDeadlines   ComplianceDeadline[]
  materialityThresholds MaterialityThreshold[]
  approvals             Approval[]
  agentRuns             AgentRun[]

  @@map("organizations")
}

/// Links a Supabase auth user to an organization with an internal role.
/// `userId` is the Supabase `auth.users.id` (uuid) — there is no local
/// `users` table; profile fields beyond email are looked up from Supabase
/// auth metadata at read time to avoid a second source of truth.
model Membership {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @db.Uuid
  // Nullable: a row invited via inviteStaffMemberAction (Settings -> Team)
  // exists before the person has ever signed in — same "pending invite,
  // claimed by matching email on first sign-in" shape as ClientMembership.
  // See lib/os/auth/session.ts.
  userId              String?  @db.Uuid
  email               String
  displayName         String?
  role                OrgRole
  isActive            Boolean  @default(true)
  // A manager-set target, not a measured actual — there's no time-tracking
  // data yet (Billing/Time entry is Phase 3), so this is the honest input
  // Team & Capacity has to work with: workload (assigned open tasks) is
  // measured; capacity is declared. Null until someone sets it.
  weeklyCapacityHours Int?
  // Per decision #4 (role mapping): a Senior CFO Reviewer (PORTFOLIO_LEAD)
  // may release routine reports to a client only where the Managing
  // Partner has explicitly delegated that authority — this flag is that
  // delegation, set by a Managing Partner/Practice Admin, not something a
  // reviewer can grant themselves. Meaningless (ignored) for roles that
  // already carry release authority unconditionally (Managing Partner) or
  // never carry it at all (Finance Associate and below).
  canReleaseReports   Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  portfolioLeadFor     Client[]           @relation("PortfolioLead")
  relationshipOwnerFor Client[]           @relation("RelationshipOwner")
  auditEvents          AuditEvent[]
  assignedTasks        Task[]             @relation("TaskAssignee")
  uploadedDocuments    Document[]         @relation("DocumentUploadedBy")
  reviewsGiven         Review[]           @relation("ReviewReviewer")
  reviewsReceived      Review[]           @relation("ReviewPreparer")
  clientInvitesSent    ClientMembership[] @relation("ClientInviteSentBy")
  requestsRaised       Request[]          @relation("RequestRaisedBy")
  requestsAssigned     Request[]          @relation("RequestAssignee")
  meetingsLogged       Meeting[]          @relation("MeetingLoggedBy")
  decisionsOwned       Decision[]         @relation("DecisionOwner")

  documentExtractionsReviewed DocumentExtraction[] @relation("DocumentExtractionReviewedBy")
  cfoReviewsCreated           CfoReview[]          @relation("CfoReviewCreatedBy")
  reviewFindingsOwned         ReviewFinding[]      @relation("ReviewFindingOwner")
  risksOwned                  Risk[]               @relation("RiskOwner")
  actionItemsOwned            ActionItem[]         @relation("ActionItemOwner")
  approvalsGiven              Approval[]           @relation("ApprovalApprover")
  agentRunsTriggered          AgentRun[]           @relation("AgentRunTriggeredBy")

  @@unique([organizationId, userId])
  @@unique([organizationId, email])
  @@index([organizationId, role])
  @@map("memberships")
}

model Client {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  name        String
  tradingName String?
  country     String
  currency    String  @default("KES")

  serviceBucket  ServiceBucket
  lifecycleStage ClientLifecycleStage @default(PROSPECT)
  healthScore    Int?
  healthStatus   ClientHealthStatus?

  portfolioLeadId     String? @db.Uuid
  relationshipOwnerId String? @db.Uuid

  reportingYearEnd    String? // e.g. "12-31"
  engagementStartDate DateTime?
  engagementEndDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portfolioLead     Membership?  @relation("PortfolioLead", fields: [portfolioLeadId], references: [id])
  relationshipOwner Membership?  @relation("RelationshipOwner", fields: [relationshipOwnerId], references: [id])

  contacts          ClientContact[]
  workflowInstances WorkflowInstance[]
  documents         Document[]
  clientMemberships ClientMembership[]
  requests          Request[]
  meetings          Meeting[]

  reportingPeriods      ReportingPeriod[]
  financialAccounts     FinancialAccount[]
  financialPeriodValues FinancialPeriodValue[]
  financialMetrics      FinancialMetric[]
  cfoReviews            CfoReview[]
  risks                 Risk[]
  controls              Control[]
  actionItems           ActionItem[]
  complianceDeadlines   ComplianceDeadline[]
  materialityThresholds MaterialityThreshold[]
  agentRuns             AgentRun[]

  @@index([organizationId, lifecycleStage])
  @@index([organizationId, serviceBucket])
  @@map("clients")
}

model ClientContact {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  name      String
  email     String
  phone     String?
  role      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

/// Append-only audit trail. Never update or delete rows from this table at
/// the application layer — see /docs/security.md.
model AuditEvent {
  id                String      @id @default(uuid()) @db.Uuid
  organizationId    String      @db.Uuid
  actorMembershipId String?     @db.Uuid
  actorLabel        String? // system/automation events, or a client-portal actor — anything with no internal Membership
  action            AuditAction
  targetType        String
  targetId          String?
  metadata          Json?
  createdAt         DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        Membership?  @relation(fields: [actorMembershipId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

/// A reusable recipe for recurring or one-off work (e.g. "Monthly
/// Management Accounts", "Quarterly Board Pack"). Holds TaskTemplates;
/// instantiated per client per period into a WorkflowInstance. Editing a
/// template never rewrites history — WorkflowInstance/Task copy the values
/// they need at creation time (see /docs/data-model.md).
model WorkflowTemplate {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  name           String
  description    String?
  serviceBucket  ServiceBucket
  recurrence     RecurrenceType
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskTemplates TaskTemplate[]
  instances     WorkflowInstance[]

  @@index([organizationId, serviceBucket])
  @@map("workflow_templates")
}

/// One task blueprint within a WorkflowTemplate. `relativeDueDays` is days
/// from the owning WorkflowInstance's periodStart — e.g. 5 means "due 5
/// days into the period" — so the same template produces correctly-dated
/// tasks regardless of which period it's instantiated for.
model TaskTemplate {
  id                  String   @id @default(uuid()) @db.Uuid
  workflowTemplateId  String   @db.Uuid
  title               String
  description         String?
  order               Int      @default(0)
  relativeDueDays     Int      @default(0)
  defaultAssigneeRole OrgRole?
  createdAt           DateTime @default(now())

  workflowTemplate WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)

  @@index([workflowTemplateId, order])
  @@map("task_templates")
}

/// One instantiation of a WorkflowTemplate for one Client covering one
/// period (e.g. "Monthly Management Accounts — March 2026" for Amboseli
/// Fresh Foods). `name`/`serviceBucket` are copied from the template at
/// creation time rather than joined live, so renaming or archiving a
/// template never changes the record of what was actually delivered.
/// `workflowTemplateId` is nullable — a lead can also open a one-off
/// workflow with no reusable template behind it.
model WorkflowInstance {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @db.Uuid
  clientId           String                 @db.Uuid
  workflowTemplateId String?                @db.Uuid
  name               String
  serviceBucket      ServiceBucket
  periodStart        DateTime
  periodEnd          DateTime
  status             WorkflowInstanceStatus @default(OPEN)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workflowTemplate WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id], onDelete: SetNull)
  tasks            Task[]

  @@index([organizationId, status])
  @@index([clientId, periodStart])
  @@map("workflow_instances")
}

model Task {
  id                   String     @id @default(uuid()) @db.Uuid
  workflowInstanceId   String     @db.Uuid
  title                String
  description          String?
  order                Int        @default(0)
  status               TaskStatus @default(NOT_STARTED)
  dueDate              DateTime
  assigneeMembershipId String?    @db.Uuid
  completedAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  assignee         Membership?      @relation("TaskAssignee", fields: [assigneeMembershipId], references: [id], onDelete: SetNull)
  reviews          Review[]
  documents        Document[]
  clientApprovals  ClientApproval[]

  @@index([workflowInstanceId, order])
  @@index([assigneeMembershipId])
  @@index([dueDate])
  @@map("tasks")
}

/// One review pass on a Task, taken while it sits at TaskStatus.UNDER_REVIEW.
/// `preparerMembershipId` copies the task's assignee *at review time* (not
/// joined live) so the segregation-of-duties record survives a later
/// reassignment — see canReview() in lib/os/auth/rbac.ts, enforced in
/// app/os/(app)/quality/actions.ts before this row is ever created.
/// Deliberately layered onto the existing Task lifecycle (UNDER_REVIEW ->
/// APPROVED/back to IN_PROGRESS) rather than a separate Deliverable entity
/// — see /docs/decision-log.md for why.
model Review {
  id                   String        @id @default(uuid()) @db.Uuid
  taskId               String        @db.Uuid
  reviewerMembershipId String        @db.Uuid
  preparerMembershipId String?       @db.Uuid
  outcome              ReviewOutcome
  comments             String?
  createdAt            DateTime      @default(now())

  task     Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewer Membership  @relation("ReviewReviewer", fields: [reviewerMembershipId], references: [id])
  preparer Membership? @relation("ReviewPreparer", fields: [preparerMembershipId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([reviewerMembershipId])
  @@map("reviews")
}

/// One uploaded file. `storagePath` is the Supabase Storage object key
/// (bucket "documents") — the actual bytes never pass through Postgres.
/// Uploads and downloads both go through short-lived signed URLs minted
/// server-side (see src/lib/storage.ts); no client ever holds a long-lived
/// credential for the bucket. `clientId` is nullable so the practice can
/// store organization-wide files (templates, policies) alongside
/// client-specific ones. `taskId` is a further-nullable narrowing — a
/// task-scoped document always has `clientId` set too (auto-derived from
/// the task's client server-side, not user-supplied — see
/// app/os/(app)/documents/actions.ts), so client-level listing never
/// misses a task's files.
model Document {
  id                           String   @id @default(uuid()) @db.Uuid
  organizationId               String   @db.Uuid
  clientId                     String?  @db.Uuid
  taskId                       String?  @db.Uuid
  uploadedByMembershipId       String?  @db.Uuid
  uploadedByClientMembershipId String?  @db.Uuid
  fileName                     String
  storagePath                  String   @unique
  mimeType                     String
  sizeBytes                    Int
  createdAt                    DateTime @default(now())

  organization               Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                     Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  task                       Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy                 Membership?       @relation("DocumentUploadedBy", fields: [uploadedByMembershipId], references: [id], onDelete: SetNull)
  uploadedByClientMembership ClientMembership? @relation(fields: [uploadedByClientMembershipId], references: [id], onDelete: SetNull)

  extractions             DocumentExtraction[]
  sourceForPeriodValues   FinancialPeriodValue[]
  sourceForReviewFindings ReviewFinding[]

  @@index([organizationId, clientId])
  @@index([organizationId, createdAt])
  @@index([taskId])
  @@map("documents")
}

/// A client-facing user account, scoped to exactly one `Client` — never
/// the whole `Organization`, unlike internal `Membership`. Not self-serve:
/// only created when internal staff sends an invite
/// (`inviteClientUserAction`). `userId` stays null until the invited
/// person actually completes sign-in for the first time — the row is
/// matched and claimed by `email` at that point (see
/// `lib/os/auth/portal-session.ts`), the same "invite now, identity later"
/// shape as any invite-based system. `ClientRole` is deliberately a
/// separate enum from `OrgRole` — a client contact must never be
/// confusable with internal staff, in the type system or anywhere else.
model ClientMembership {
  id                    String     @id @default(uuid()) @db.Uuid
  clientId              String     @db.Uuid
  userId                String?    @db.Uuid
  email                 String
  displayName           String?
  role                  ClientRole @default(CLIENT_COLLABORATOR)
  isActive              Boolean    @default(true)
  invitedByMembershipId String?    @db.Uuid
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invitedBy         Membership?      @relation("ClientInviteSentBy", fields: [invitedByMembershipId], references: [id], onDelete: SetNull)
  approvals         ClientApproval[]
  uploadedDocuments Document[]
  requestsRaised    Request[]

  @@unique([clientId, email])
  @@index([userId])
  @@map("client_memberships")
}

/// A client user's sign-off (or change request) on one `Task`, taken while
/// it sits at `TaskStatus.APPROVED` — i.e. after it's already passed
/// internal Quality review (see `Review`). Same shape as `Review`
/// deliberately, but kept as a separate model/table: the actor is a
/// `ClientMembership`, not a `Membership`, and mixing the two into one
/// polymorphic table would make every query about "who reviewed this"
/// need to handle two actor types instead of picking the right table.
model ClientApproval {
  id                 String                @id @default(uuid()) @db.Uuid
  taskId             String                @db.Uuid
  clientMembershipId String                @db.Uuid
  outcome            ClientApprovalOutcome
  comments           String?
  createdAt          DateTime              @default(now())

  task             Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  clientMembership ClientMembership @relation(fields: [clientMembershipId], references: [id])

  @@index([taskId, createdAt])
  @@index([clientMembershipId])
  @@map("client_approvals")
}

/// An ad hoc, unscheduled ask — as opposed to Task, which belongs to a
/// planned WorkflowInstance. Always scoped to exactly one Client (unlike
/// Document/Task, there's no "general, not client-specific" request).
/// `raisedByMembershipId` (staff logging it on the client's behalf) and
/// `raisedByClientMembershipId` (the client raising it themselves through
/// the portal) are exactly-one-set nullable columns, the same
/// two-uploader-column pattern Document already uses for the same reason —
/// see /docs/decision-log.md "Client-uploaded documents get their own
/// uploader column."
model Request {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  clientId       String @db.Uuid

  title       String
  description String?
  priority    RequestPriority @default(MEDIUM)
  status      RequestStatus   @default(NEW)

  // Set at triage time (triageRequestAction), derived from priority — not a
  // deadline the requester picks. Null until triaged.
  slaDueAt DateTime?

  raisedByMembershipId       String? @db.Uuid
  raisedByClientMembershipId String? @db.Uuid
  assigneeMembershipId       String? @db.Uuid

  resolutionNotes String?
  resolvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization             Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  raisedBy                 Membership?       @relation("RequestRaisedBy", fields: [raisedByMembershipId], references: [id], onDelete: SetNull)
  raisedByClientMembership ClientMembership? @relation(fields: [raisedByClientMembershipId], references: [id], onDelete: SetNull)
  assignee                 Membership?       @relation("RequestAssignee", fields: [assigneeMembershipId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, slaDueAt])
  @@index([clientId])
  @@map("requests")
}

/// A logged client meeting — date, attendees (free text), notes. Decisions
/// made in it are tracked separately (Decision) rather than buried in the
/// notes field, since product principle #3 ("one accountable owner") needs
/// each decision to carry its own owner and due date, not just prose.
model Meeting {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  clientId       String @db.Uuid

  title     String
  heldAt    DateTime
  attendees String?
  notes     String?

  loggedByMembershipId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  loggedBy     Membership?  @relation("MeetingLoggedBy", fields: [loggedByMembershipId], references: [id], onDelete: SetNull)
  decisions    Decision[]

  @@index([organizationId, clientId])
  @@index([organizationId, heldAt])
  @@map("meetings")
}

/// One decision made in one Meeting, with a named accountable owner and an
/// optional due date — the "decisions" half of Meetings & decisions.
model Decision {
  id          String         @id @default(uuid()) @db.Uuid
  meetingId   String         @db.Uuid
  description String
  dueDate     DateTime?
  status      DecisionStatus @default(OPEN)

  ownerMembershipId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  owner   Membership? @relation("DecisionOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([ownerMembershipId, status])
  @@map("decisions")
}

// --- AI CFO models -----------------------------------------------------

/// A client's financial reporting period (e.g. "March 2026", or an audited
/// FY). Anchors everything downstream — extracted figures, calculated
/// metrics, and diagnostic reviews all reference one, so "which period is
/// this number for" is never ambiguous or re-derived differently in two
/// places.
model ReportingPeriod {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  clientId       String   @db.Uuid
  label          String
  periodStart    DateTime
  periodEnd      DateTime
  currency       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  documentExtractions   DocumentExtraction[]
  financialPeriodValues FinancialPeriodValue[]
  financialMetrics      FinancialMetric[]
  cfoReviews            CfoReview[]

  @@index([organizationId, clientId])
  @@index([clientId, periodStart])
  @@map("reporting_periods")
}

/// One attempt to classify and structurally extract data from an uploaded
/// Document. Kept separate from Document (which just represents the file)
/// so a failed or re-run extraction never loses the history of what was
/// tried — retries create new rows, they don't overwrite the last attempt.
/// `structuredData`/`sourceLocations` carry the raw extracted values with
/// their provenance (page/sheet/cell/row); FinancialPeriodValue rows are
/// the normalized, reviewed result once a human has signed off on an
/// extraction.
model DocumentExtraction {
  id                     String                   @id @default(uuid()) @db.Uuid
  organizationId         String                   @db.Uuid
  documentId             String                   @db.Uuid
  reportingPeriodId      String?                  @db.Uuid
  status                 DocumentExtractionStatus @default(PENDING)
  documentType           String? // e.g. "trial_balance", "bank_statement" — free-form, the Document Agent's own classification vocabulary, not a closed enum yet
  extractedCompany       String?
  extractedCurrency      String?
  structuredData         Json?
  confidence             Float? // 0..1
  model                  String?
  promptVersion          String?
  errorMessage           String?
  reviewedByMembershipId String?                  @db.Uuid
  reviewedAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reportingPeriod ReportingPeriod? @relation(fields: [reportingPeriodId], references: [id], onDelete: SetNull)
  reviewedBy      Membership?      @relation("DocumentExtractionReviewedBy", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)

  @@index([organizationId, documentId])
  @@index([reportingPeriodId])
  @@map("document_extractions")
}

enum FinancialAccountCategory {
  REVENUE
  COST_OF_SALES
  OPERATING_EXPENSE
  ASSET
  LIABILITY
  EQUITY
  OTHER
}

/// A normalized chart-of-accounts entry for one client — the taxonomy
/// FinancialPeriodValue amounts are recorded against, since every client's
/// own bookkeeping uses different account names/codes.
model FinancialAccount {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  clientId       String                   @db.Uuid
  code           String?
  name           String
  category       FinancialAccountCategory
  createdAt      DateTime                 @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  periodValues FinancialPeriodValue[]

  @@index([organizationId, clientId])
  @@map("financial_accounts")
}

/// One normalized, sourced figure: this account, this period, this amount
/// — with `sourceDocumentId`/`sourceLocation` so a report or a reviewer can
/// always trace a number back to the page/sheet/cell/row it came from.
/// Never derive FinancialMetric values from anything except rows in this
/// table plus other FinancialMetric rows — a metric with no traceable
/// FinancialPeriodValue behind it is exactly the "unsupported assumption
/// presented as fact" the product spec prohibits.
model FinancialPeriodValue {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  clientId           String   @db.Uuid
  reportingPeriodId  String   @db.Uuid
  financialAccountId String   @db.Uuid
  amount             Decimal  @db.Decimal(18, 2)
  currency           String
  sourceDocumentId   String?  @db.Uuid
  sourceLocation     Json? // { page, sheet, cell, row } — whichever apply to the source file type
  createdAt          DateTime @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reportingPeriod  ReportingPeriod  @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  sourceDocument   Document?        @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([organizationId, clientId, reportingPeriodId])
  @@index([financialAccountId])
  @@map("financial_period_values")
}

/// One output of the deterministic calculation engine (lib/os/finance/) —
/// `metricKey` matches that module's function names (e.g.
/// "CASH_RUNWAY_MONTHS"), `formula`/`inputsJson`/`warnings` are copied
/// straight from the CalculationResult it came from, so a stored metric is
/// exactly as auditable as a freshly-computed one.
model FinancialMetric {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  clientId          String   @db.Uuid
  reportingPeriodId String   @db.Uuid
  metricKey         String
  value             Decimal? @db.Decimal(18, 4)
  formula           String
  inputsJson        Json
  warnings          Json?
  calculatedAt      DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)

  @@index([organizationId, clientId, reportingPeriodId])
  @@index([reportingPeriodId, metricKey])
  @@map("financial_metrics")
}

/// A financial-diagnostic review covering one Client/ReportingPeriod — the
/// approval-lifecycle object the CFO Inbox and Approval Centre operate on.
/// Distinct from the existing Review model (task-level preparer/reviewer
/// QA on one delivery Task) — this is a whole-engagement diagnostic with
/// its own multi-stage approval chain up to the Managing Partner.
model CfoReview {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @db.Uuid
  clientId              String          @db.Uuid
  reportingPeriodId     String          @db.Uuid
  type                  String // e.g. "financial_diagnostic", "monthly_close"
  status                CfoReviewStatus @default(DRAFT)
  createdByMembershipId String?         @db.Uuid
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reportingPeriod ReportingPeriod @relation(fields: [reportingPeriodId], references: [id], onDelete: Cascade)
  createdBy       Membership?     @relation("CfoReviewCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  findings ReviewFinding[]

  @@index([organizationId, clientId])
  @@index([status])
  @@map("cfo_reviews")
}

/// One finding within a CfoReview — the structured shape the product spec
/// requires for every finding: category, evidence, source, amount, risk
/// rating, confidence, recommended action, owner, target date, status. See
/// lib/os/finance/ for how `amount`/confidence-bearing figures should be
/// computed, and MaterialityThreshold for how `riskRating` is meant to be
/// assigned consistently rather than picked by feel.
model ReviewFinding {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @db.Uuid
  cfoReviewId       String        @db.Uuid
  category          String
  finding           String
  evidence          String?
  sourceDocumentId  String?       @db.Uuid
  sourceLocation    Json?
  amount            Decimal?      @db.Decimal(18, 2)
  currency          String?
  riskRating        RiskRating
  confidence        Float // 0..1
  recommendedAction String?
  ownerMembershipId String?       @db.Uuid
  targetDate        DateTime?
  status            FindingStatus @default(OPEN)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cfoReview      CfoReview    @relation(fields: [cfoReviewId], references: [id], onDelete: Cascade)
  sourceDocument Document?    @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  owner          Membership?  @relation("ReviewFindingOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)

  risks   Risk[]
  actions ActionItem[]

  @@index([organizationId, cfoReviewId])
  @@index([riskRating, status])
  @@map("review_findings")
}

model Risk {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @db.Uuid
  clientId          String     @db.Uuid
  category          String
  description       String
  riskRating        RiskRating
  status            RiskStatus @default(OPEN)
  ownerMembershipId String?    @db.Uuid
  sourceFindingId   String?    @db.Uuid
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner         Membership?    @relation("RiskOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  sourceFinding ReviewFinding? @relation(fields: [sourceFindingId], references: [id], onDelete: SetNull)

  actions ActionItem[]

  @@index([organizationId, clientId])
  @@index([riskRating, status])
  @@map("risks")
}

model Control {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  clientId       String        @db.Uuid
  description    String
  status         ControlStatus @default(EFFECTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, clientId])
  @@map("controls")
}

/// An action-tracker item — the "who/what/when" the product spec requires
/// for every finding, risk, or ad hoc follow-up. `sourceFindingId`/
/// `sourceRiskId` are optional so an action can also stand alone.
model ActionItem {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  clientId          String           @db.Uuid
  description       String
  ownerMembershipId String?          @db.Uuid
  targetDate        DateTime?
  status            ActionItemStatus @default(OPEN)
  sourceFindingId   String?          @db.Uuid
  sourceRiskId      String?          @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner         Membership?    @relation("ActionItemOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  sourceFinding ReviewFinding? @relation(fields: [sourceFindingId], references: [id], onDelete: SetNull)
  sourceRisk    Risk?          @relation(fields: [sourceRiskId], references: [id], onDelete: SetNull)

  @@index([organizationId, clientId])
  @@index([ownerMembershipId, status])
  @@map("action_items")
}

/// A statutory/compliance deadline for the Command Centre's "upcoming
/// compliance deadlines" panel — distinct from Request.slaDueAt (an
/// internal SLA) and Task.dueDate (planned delivery work).
model ComplianceDeadline {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  clientId       String         @db.Uuid
  description    String
  category       String
  dueDate        DateTime
  status         DeadlineStatus @default(OPEN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([organizationId, clientId])
  @@index([dueDate])
  @@map("compliance_deadlines")
}

/// Configurable escalation thresholds — see decision #5 in
/// /docs/decision-log.md for the CFOIP default KES configuration this
/// table is seeded with. `clientId` null means an organization-wide
/// default; a row with `clientId` set overrides it for that one client.
/// Percent and absolute thresholds are stored separately per row — the
/// severity is triggered by whichever is crossed first (see
/// lib/os/finance/materiality.ts, built once this schema lands).
model MaterialityThreshold {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @db.Uuid
  clientId          String?             @db.Uuid
  category          MaterialityCategory
  riskRating        RiskRating
  percentThreshold  Decimal?            @db.Decimal(7, 4)
  absoluteThreshold Decimal?            @db.Decimal(18, 2)
  currency          String
  benchmark         String              @default("REVENUE") // what the percent threshold is a percent OF, when revenue isn't reliable
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([organizationId, clientId, category, riskRating])
  @@map("materiality_thresholds")
}

/// A generic approval-decision log — many entity types need one (findings,
/// reviews, reports later), so this is a single append-only table keyed by
/// (targetType, targetId) rather than a bespoke approvals table per entity.
model Approval {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @db.Uuid
  targetType           String
  targetId             String
  decision             ApprovalDecision
  approverMembershipId String           @db.Uuid
  riskRatingAtDecision RiskRating?
  comments             String?
  createdAt            DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approver     Membership   @relation("ApprovalApprover", fields: [approverMembershipId], references: [id])

  @@index([organizationId, targetType, targetId])
  @@map("approvals")
}

/// One orchestrator run of an AI CFO workflow (e.g. the financial
/// diagnostic) for one client. `model`/`modelVersion`/`promptVersion`/
/// `workflowVersion` are recorded on every run per the product spec's
/// output-control requirements — never inferred after the fact from
/// whatever the current code happens to be.
model AgentRun {
  id                      String         @id @default(uuid()) @db.Uuid
  organizationId          String         @db.Uuid
  clientId                String         @db.Uuid
  workflowType            String
  status                  AgentRunStatus @default(QUEUED)
  triggeredByMembershipId String?        @db.Uuid
  model                   String?
  modelVersion            String?
  promptVersion           String?
  workflowVersion         String?
  startedAt               DateTime?
  completedAt             DateTime?
  inputTokens             Int?
  outputTokens            Int?
  errorMessage            String?
  createdAt               DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  triggeredBy  Membership?  @relation("AgentRunTriggeredBy", fields: [triggeredByMembershipId], references: [id], onDelete: SetNull)

  steps AgentStep[]

  @@index([organizationId, clientId])
  @@index([status])
  @@map("agent_runs")
}

/// One step within an AgentRun — one specialist agent's turn (see
/// /docs/decision-log.md "AI CFO agent architecture" for the
/// orchestrator/specialist split). `input`/`output` are the step's own
/// structured payload, not a full LLM transcript — token-level detail
/// belongs in provider-side logs, not this table.
model AgentStep {
  id           String         @id @default(uuid()) @db.Uuid
  agentRunId   String         @db.Uuid
  agentType    AgentType
  stepName     String
  input        Json?
  output       Json?
  status       AgentRunStatus @default(QUEUED)
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?
  createdAt    DateTime       @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
  @@map("agent_steps")
}
